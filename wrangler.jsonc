{
  "name": "aidenhq-site",
  "main": "web/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "web/public", "binding": "ASSETS", "run_worker_first": ["/", "/install.sh"] },
  "workers_dev": true,
  // The installer get.aidenhq.ai serves: a release tag and its install.sh sha256 (release.yml's site job moves them on main and deploys).
  "vars": { "INSTALLER_TAG": "2026.11.2", "INSTALLER_SHA256": "1f0f2f63df660d69bbf42a0d6f0e06f49a44beeede9fe79d57c673fdfcceec87" },
  "routes": [
    { "pattern": "aidenhq.ai", "custom_domain": true },
    { "pattern": "get.aidenhq.ai", "custom_domain": true }
  ]
}
